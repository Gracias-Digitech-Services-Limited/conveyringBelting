# Reverse proxy for the single EC2 instance (Next.js runs on 127.0.0.1:3000 via PM2 or Docker).
# Copy to /etc/nginx/sites-available/conveyorbelting.ie and symlink into sites-enabled.

server {
    listen 80;
    server_name conveyorbelting.ie www.conveyorbelting.ie;

    # Redirect www -> apex (or flip this the other way, pick one canonical host)
    if ($host = www.conveyorbelting.ie) {
        return 301 https://conveyorbelting.ie$request_uri;
    }

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name conveyorbelting.ie;

    ssl_certificate     /etc/letsencrypt/live/conveyorbelting.ie/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/conveyorbelting.ie/privkey.pem;

    client_max_body_size 20m; # allow media/PDF uploads through the admin panel

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
